# Copy to .env and fill in. .env is git-ignored; never commit real values.

# GoRest token for POST/PUT/PATCH/DELETE tests (https://gorest.co.in/consumer/login).
# Without it, write tests are skipped and read tests still run.
GOREST_TOKEN=

# Optional overrides
# BASE_URL=https://www.saucedemo.com
# API_BASE_URL=https://gorest.co.in
# HEADLESS=false
